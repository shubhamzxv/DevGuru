{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadProgressFiles",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::com.shubham.devguru/progress/*"
    },
    {
      "Sid": "PublicWriteProgressFiles",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::com.shubham.devguru/progress/*.json"
    },
    {
      "Sid": "HttpsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::com.shubham.devguru", "arn:aws:s3:::com.shubham.devguru/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
